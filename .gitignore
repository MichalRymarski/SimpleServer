# Project exclude paths

# gradle
/.gradle/
/build/

# kotlin plugin session data
/.kotlin/

# intellij build output (if not using gradle delegation)
/out/

# JTE precompiled template classes (regenerated by precompileJte)
/jte-classes/

# local run logs
*.log

# local opencode config (points at localhost dev server)
opencode.json

# local scratch / probe files
headers.txt
insight.txt
body.txt
body8000.txt
